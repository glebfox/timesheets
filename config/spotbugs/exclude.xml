<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- Vaadin components are Serializable, but the application never serializes a session: a view's beans and its
         components' fields need not be serializable -->
    <Match>
        <Bug code="Se,SnVI"/>
    </Match>

    <!-- Entities hand out their collections for data containers to bind, and beans keep the references they are given:
         copying them would break both -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- A finalizer attack needs untrusted code in the same JVM, which the application never loads; constructors
         reject invalid arguments by throwing -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- The format string is a JPQL query, whose line breaks are whitespace, not output -->
    <Match>
        <Class name="com.glebfox.timesheets.app.TimeEntryApprovalSupport"/>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>
</FindBugsFilter>
