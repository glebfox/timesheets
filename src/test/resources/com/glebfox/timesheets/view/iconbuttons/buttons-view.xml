<view xmlns="http://jmix.io/schema/flowui/view">
    <actions>
        <action id="add" icon="gravity-ui:plus"/>
        <action id="addWithText" icon="gravity-ui:plus" text="Add"/>
    </actions>
    <layout>
        <dataGrid id="grid">
            <actions>
                <action id="create" type="list_create"/>
                <action id="track" type="list_itemTracking" icon="gravity-ui:check"/>
            </actions>
        </dataGrid>
        <button id="iconNoTooltip" icon="gravity-ui:plus"/>
        <button id="iconWithTooltip" icon="gravity-ui:plus">
            <tooltip text="Add"/>
        </button>
        <button id="iconEmptyTooltip" icon="gravity-ui:plus">
            <tooltip text=""/>
        </button>
        <button id="iconChildNoTooltip">
            <icon icon="gravity-ui:plus"/>
        </button>
        <button id="prefixChildNoTooltip">
            <prefix>
                <icon icon="gravity-ui:plus"/>
            </prefix>
        </button>
        <button id="iconAndText" icon="gravity-ui:plus" text="Add"/>
        <button id="actionIconNoText" action="add"/>
        <button id="actionWithText" action="addWithText"/>
        <button id="typedAction" action="grid.create" icon="gravity-ui:plus"/>
        <button id="typedActionEmptyText" action="grid.create" text=""/>
        <button id="actionWithTextEmptyText" action="addWithText" text=""/>
        <button id="trackingActionIconNoText" action="grid.track"/>
        <button id="undeclaredAction" action="other.run" icon="gravity-ui:plus"/>
        <button id="textOnly" text="Add"/>
        <dropdownButton id="dropdownIconOnly" icon="gravity-ui:plus"/>
    </layout>
</view>
