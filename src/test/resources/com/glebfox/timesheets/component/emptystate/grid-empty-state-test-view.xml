<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:app="http://glebfox.com/schema/app-ui-components.xsd">
    <data readOnly="true">
        <collection id="taskTypesDc"
                    class="com.glebfox.timesheets.entity.task.TaskType">
            <fetchPlan extends="_base"/>
            <loader id="taskTypesDl" readOnly="true">
                <query>
                    <![CDATA[select e from ts_TaskType e where e.name like 'grid-empty-state-test-%']]>
                </query>
            </loader>
        </collection>
        <!-- No loader: nothing fills it -->
        <collection id="plainTaskTypesDc"
                    class="com.glebfox.timesheets.entity.task.TaskType"/>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <dataGrid id="refreshGrid"
                  width="100%"
                  dataContainer="taskTypesDc">
            <actions>
                <action id="refresh" type="list_refresh"/>
            </actions>
            <columns>
                <column property="name"/>
                <column property="description"/>
            </columns>
            <emptyStateComponent>
                <app:gridEmptyState icon="ts:task-types" text="No task types"/>
            </emptyStateComponent>
        </dataGrid>
        <dataGrid id="plainGrid"
                  width="100%"
                  dataContainer="plainTaskTypesDc">
            <columns>
                <column property="name"/>
                <column property="description"/>
            </columns>
            <emptyStateComponent>
                <app:gridEmptyState icon="ts:tag" text="No tags"/>
            </emptyStateComponent>
        </dataGrid>
    </layout>
</view>
