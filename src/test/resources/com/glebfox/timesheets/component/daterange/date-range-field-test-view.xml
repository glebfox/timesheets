<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:app="http://glebfox.com/schema/app-ui-components.xsd">
    <data>
        <!-- No loader: a test sets the item -->
        <instance id="absenceDc"
                  class="com.glebfox.timesheets.entity.absence.Absence"/>
    </data>
    <layout>
        <app:dateRangeField id="configuredField"
                            label="Period"
                            required="true"
                            requiredMessage="Period required"
                            readOnly="true"
                            startPlaceholder="From"
                            endPlaceholder="To"
                            startAriaLabel="Start"
                            endAriaLabel="End"
                            clearButtonVisible="true"
                            summaryVisible="true"
                            width="20em"
                            classNames="extra"/>
        <app:dateRangeField id="boundField"
                            dataContainer="absenceDc"
                            startProperty="firstDay"
                            endProperty="lastDay"/>
    </layout>
</view>
