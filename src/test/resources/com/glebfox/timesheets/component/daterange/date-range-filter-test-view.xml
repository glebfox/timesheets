<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:app="http://glebfox.com/schema/app-ui-components.xsd">
    <data readOnly="true">
        <collection id="absencesDc"
                    class="com.glebfox.timesheets.entity.absence.Absence">
            <!-- No dataLoadCoordinator: a test sets the user and loads -->
            <loader id="absencesDl" readOnly="true">
                <query>
                    <![CDATA[select e from ts_Absence e where e.user = :user order by e.firstDay desc]]>
                </query>
            </loader>
        </collection>
    </data>
    <layout>
        <app:dateRangeFilter id="periodFilter"
                             dataLoader="absencesDl"
                             startProperty="firstDay"
                             endProperty="lastDay"
                             labelVisible="false">
            <app:dateRangeField startPlaceholder="From"
                                endPlaceholder="To"
                                clearButtonVisible="true"/>
        </app:dateRangeFilter>
    </layout>
</view>
