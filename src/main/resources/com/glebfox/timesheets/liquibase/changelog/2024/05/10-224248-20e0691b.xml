<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="ts">
        <createTable tableName="TS_TAG">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_TS_TAG"/>
            </column>
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="TAG_GROUP_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="ts">
        <createTable tableName="TS_TAG_GROUP">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_TS_TAG_GROUP"/>
            </column>
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="PROJECT_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="3" author="ts">
        <createTable tableName="TS_TIME_ENTRY_TAG_LINK">
            <column name="TAG_ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_TS_TIME_ENTRY_TAG_LINK"/>
            </column>
            <column name="TIME_ENTRY_ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_TS_TIME_ENTRY_TAG_LINK"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="4" author="ts">
        <createIndex indexName="IDX_TS_TAG_GROUP_PROJECT" tableName="TS_TAG_GROUP">
            <column name="PROJECT_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="PROJECT_ID" baseTableName="TS_TAG_GROUP"
                                 constraintName="FK_TS_TAG_GROUP_ON_PROJECT" referencedColumnNames="ID"
                                 referencedTableName="TS_PROJECT"/>
    </changeSet>
    <changeSet id="5" author="ts">
        <createIndex indexName="IDX_TS_TAG_TAG_GROUP" tableName="TS_TAG">
            <column name="TAG_GROUP_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="TAG_GROUP_ID" baseTableName="TS_TAG"
                                 constraintName="FK_TS_TAG_ON_TAG_GROUP" referencedColumnNames="ID"
                                 referencedTableName="TS_TAG_GROUP"/>
    </changeSet>
    <changeSet id="6" author="ts">
        <addForeignKeyConstraint baseColumnNames="TAG_ID" baseTableName="TS_TIME_ENTRY_TAG_LINK"
                                 constraintName="FK_TSTIMENTTAG_ON_TAG" referencedColumnNames="ID"
                                 referencedTableName="TS_TAG"/>
    </changeSet>
    <changeSet id="7" author="ts">
        <addForeignKeyConstraint baseColumnNames="TIME_ENTRY_ID" baseTableName="TS_TIME_ENTRY_TAG_LINK"
                                 constraintName="FK_TSTIMENTTAG_ON_TIME_ENTRY" referencedColumnNames="ID"
                                 referencedTableName="TS_TIME_ENTRY"/>
    </changeSet>
</databaseChangeLog>
