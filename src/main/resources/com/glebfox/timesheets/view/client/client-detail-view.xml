<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:app="http://glebfox.com/schema/app-ui-components.xsd"
      title="msg://clientDetailView.title"
      focusComponent="nameField">
    <data>
        <instance id="clientDc"
                  class="com.glebfox.timesheets.entity.client.Client">
            <fetchPlan extends="_base">
                <property name="contactInformation" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
            <instance id="contactInformationDc" property="contactInformation"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout alignItems="STRETCH"
            padding="false" spacing="false"
            expand="contentBox">
        <vbox id="contentBox" classNames="overflow-auto">
            <app:imageUpload id="imageUpload"
                             dataContainer="clientDc" property="image"/>

            <textField id="nameField"
                       dataContainer="clientDc" property="name"
                       label="msg://com.glebfox.timesheets.entity.client/Client.name"
                       width="100%" maxWidth="30em">
                <prefix>
                    <icon icon="fontawesome-regular:address-card"/>
                </prefix>
            </textField>

            <hr/>

            <details id="contactInformationDetails"
                     summaryText="msg://com.glebfox.timesheets.entity.client/Client.contactInformation"
                     width="100%"
                     opened="true"
                     themeNames="bordered summary-filled non-collapsible">
                <formLayout dataContainer="contactInformationDc">
                    <responsiveSteps>
                        <responsiveStep minWidth="0" columns="1"/>
                        <responsiveStep minWidth="60em" columns="3"/>
                    </responsiveSteps>
                    <emailField id="emailField" property="email">
                        <prefix>
                            <icon icon="gravity-ui:envelope"/>
                        </prefix>
                    </emailField>
                    <textField id="phoneField" property="phone">
                        <prefix>
                            <icon icon="gravity-ui:handset"/>
                        </prefix>
                    </textField>
                    <textField id="urlField" property="url">
                        <prefix>
                            <icon icon="gravity-ui:link"/>
                        </prefix>
                    </textField>
                    <textArea id="addressField" property="address"
                              minRows="5" maxRows="5" colspan="3">
                        <prefix>
                            <icon icon="gravity-ui:map-pin"/>
                        </prefix>
                    </textArea>
                </formLayout>
            </details>
        </vbox>

        <hbox id="detailActions"
              classNames="footer-panel">
            <button id="saveAndCloseBtn" action="saveAction"/>
            <button id="closeBtn" action="closeAction"/>
        </hbox>
    </layout>
</view>
