<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://clientListView.title"
      focusComponent="nameFilterField">
    <data readOnly="true">
        <collection id="clientsDc"
                    class="com.glebfox.timesheets.entity.client.Client">
            <fetchPlan extends="_base"/>
            <loader id="clientsDl" readOnly="true">
                <query>
                    <![CDATA[select e from ts_Client e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
            <propertyFilter component="nameFilter"/>
        </urlQueryParameters>
    </facets>
    <layout classNames="client-list-view">
        <propertyFilter id="nameFilter"
                        dataLoader="clientsDl" property="name"
                        operation="CONTAINS"
                        labelVisible="false"
                        width="100%" maxWidth="30em">
            <textField id="nameFilterField"
                       placeholder="msg://nameFilter.placeholder"
                       clearButtonVisible="true">
                <prefix>
                    <icon icon="gravity-ui:magnifier"/>
                </prefix>
            </textField>
        </propertyFilter>

        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createBtn" text="msg:///actions.Create" icon="gravity-ui:plus" themeNames="primary"/>
            <simplePagination id="pagination" dataLoader="clientsDl"/>
        </hbox>
        <vbox id="noDataContainer"
              classNames="no-data-container"
              justifyContent="CENTER"
              alignItems="CENTER"
              height="20em"
              visible="true">
            <h3 id="noDataHeader" text="msg://noData.text"/>
        </vbox>
        <virtualList id="clientsList" itemsContainer="clientsDc"/>
    </layout>
</view>
