<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://projectParticipantDetailView.title"
      focusComponent="form">
    <data>
        <instance id="projectParticipantDc"
                  class="com.glebfox.timesheets.entity.project.ProjectParticipant">
            <fetchPlan extends="_base">
                <property name="project" fetchPlan="_base"/>
                <property name="role" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
        </instance>
        <collection id="projectRolesDc"
                    class="com.glebfox.timesheets.entity.project.ProjectRole">
            <fetchPlan extends="_base"/>
            <loader id="projectRolesDl" readOnly="true">
                <query>
                    <![CDATA[select e from ts_ProjectRole e order by e.name]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout padding="false" expand="form" alignItems="STRETCH">
        <formLayout id="form"
                    dataContainer="projectParticipantDc"
                    classNames="margin-inline-m">
            <entityComboBox id="userField" property="user">
                <prefix>
                    <icon icon="gravity-ui:person"/>
                </prefix>
                <actions>
                    <action id="entityLookup" type="entity_lookup"/>
                    <action id="entityClear" type="entity_clear"/>
                </actions>
                <itemsQuery class="com.glebfox.timesheets.entity.user.User"
                            searchStringFormat="(?i)%${inputString}%"
                            escapeValueForLike="true">
                    <fetchPlan extends="_instance_name">
                        <property name="avatar"/>
                        <property name="active"/>
                    </fetchPlan>
                    <query>
                        <![CDATA[select e from ts_User e
                                    where e.username like :searchString
                                        or e.firstName like :searchString
                                        or e.lastName like :searchString
                                        escape '\' order by e.username asc]]>
                    </query>
                </itemsQuery>
            </entityComboBox>
            <entityPicker id="projectField" property="project">
                <prefix>
                    <icon icon="gravity-ui:briefcase"/>
                </prefix>
                <actions>
                    <action id="entityLookup" type="entity_lookup"/>
                    <action id="entityClear" type="entity_clear"/>
                </actions>
            </entityPicker>
            <entityComboBox id="roleField" property="role"
                            itemsContainer="projectRolesDc">
                <prefix>
                    <icon icon="gravity-ui:tag"/>
                </prefix>
                <actions>
                    <action id="entityCreate" text="msg:///actions.Create" icon="gravity-ui:plus"/>
                    <action id="entityLookup" type="entity_lookup"/>
                    <action id="entityClear" type="entity_clear"/>
                </actions>
            </entityComboBox>
        </formLayout>
        <hbox id="detailActions"
              classNames="footer-panel">
            <button id="saveAndCloseBtn" action="saveAction"/>
            <button id="closeBtn" action="closeAction"/>
        </hbox>
    </layout>
</view>
