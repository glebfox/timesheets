<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://workScheduleAssignmentDetailView.title"
      focusComponent="form">
    <data>
        <instance id="workScheduleAssignmentDc"
                  class="com.glebfox.timesheets.entity.schedule.WorkScheduleAssignment">
            <fetchPlan extends="_base">
                <property name="user" fetchPlan="_instance_name"/>
                <property name="workSchedule" fetchPlan="_instance_name">
                    <property name="deletedDate"/>
                </property>
            </fetchPlan>
            <loader/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout padding="false" expand="form" alignItems="STRETCH">
        <formLayout id="form"
                    dataContainer="workScheduleAssignmentDc"
                    classNames="margin-inline-m">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
            </responsiveSteps>

            <entityPicker id="userField" property="user" readOnly="true"/>
            <datePicker id="startDateField" property="startDate"/>
            <entityComboBox id="workScheduleField" property="workSchedule">
                <itemsQuery class="com.glebfox.timesheets.entity.schedule.WorkSchedule"
                            searchStringFormat="(?i)%${inputString}%"
                            escapeValueForLike="true">
                    <!-- deletedDate is read for the helper when an unsaved assignment is opened again -->
                    <fetchPlan extends="_instance_name">
                        <property name="deletedDate"/>
                    </fetchPlan>
                    <query>
                        <![CDATA[select e from ts_WorkSchedule e
                                    where e.name like :searchString escape '\'
                                    order by e.name]]>
                    </query>
                </itemsQuery>
            </entityComboBox>
        </formLayout>
        <hbox id="detailActions"
              classNames="footer-panel">
            <button id="saveAndCloseBtn" action="saveAction"/>
            <button id="closeBtn" action="closeAction"/>
        </hbox>
    </layout>
</view>
