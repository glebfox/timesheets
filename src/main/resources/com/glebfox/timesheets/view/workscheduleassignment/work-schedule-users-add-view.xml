<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://workScheduleUsersAddView.title"
      focusComponent="form">
    <actions>
        <action id="okAction"
                text="msg:///actions.Ok"
                icon="DETAIL_SAVE_CLOSE_ACTION"
                actionVariant="PRIMARY"
                shortcutCombination="${SAVE_SHORTCUT}"/>
        <action id="closeAction" type="view_close"/>
    </actions>
    <layout padding="false" expand="form" alignItems="STRETCH">
        <formLayout id="form" classNames="margin-inline-m">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
            </responsiveSteps>

            <!-- The lookup opens the user list with its filter, so any number of users can be picked there -->
            <multiSelectComboBoxPicker id="usersField"
                                       metaClass="ts_User"
                                       label="msg://usersField.label"
                                       required="true">
                <itemsQuery class="com.glebfox.timesheets.entity.user.User"
                            searchStringFormat="(?i)%${inputString}%"
                            escapeValueForLike="true">
                    <!-- The schedule editor's user cell shows the avatar and the active flag -->
                    <fetchPlan extends="_instance_name">
                        <property name="avatar"/>
                        <property name="active"/>
                    </fetchPlan>
                    <query>
                        <![CDATA[select e from ts_User e
                                    where e.username like :searchString escape '\'
                                        or e.firstName like :searchString escape '\'
                                        or e.lastName like :searchString escape '\'
                                    order by e.username asc]]>
                    </query>
                </itemsQuery>
                <actions>
                    <action id="entityLookup" type="entity_lookup"/>
                </actions>
            </multiSelectComboBoxPicker>
            <datePicker id="startDateField"
                        datatype="localDate"
                        label="msg://com.glebfox.timesheets.entity.schedule/WorkScheduleAssignment.startDate"
                        required="true"/>
            <span id="workScheduleText" classNames="secondary-text"/>
        </formLayout>
        <hbox id="detailActions"
              classNames="footer-panel">
            <button id="okBtn" action="okAction"/>
            <button id="cancelBtn" action="closeAction"/>
        </hbox>
    </layout>
</view>
