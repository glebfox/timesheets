<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://tagDetailView.title"
      focusComponent="form">
    <data>
        <instance id="tagDc"
                  class="com.glebfox.timesheets.entity.tag.Tag">
            <fetchPlan extends="_base">
                <property name="tagGroup" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout padding="false" expand="form" alignItems="STRETCH">
        <formLayout id="form"
                    dataContainer="tagDc"
                    classNames="margin-inline-m">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
            </responsiveSteps>

            <textField id="nameField" property="name" maxWidth="40em">
                <prefix>
                    <icon icon="gravity-ui:tag"/>
                </prefix>
            </textField>
            <entityPicker id="tagGroupField" property="tagGroup">
                <prefix>
                    <icon icon="gravity-ui:tags"/>
                </prefix>
                <actions>
                    <action id="entityLookup" type="entity_lookup"/>
                    <action id="entityClear" type="entity_clear"/>
                </actions>
            </entityPicker>
        </formLayout>
        <hbox id="detailActions"
              classNames="footer-panel">
            <button id="saveAndCloseBtn" action="saveAction"/>
            <button id="closeBtn" action="closeAction"/>
        </hbox>
    </layout>
</view>
