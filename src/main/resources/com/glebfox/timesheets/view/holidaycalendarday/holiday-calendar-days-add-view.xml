<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://holidayCalendarDaysAddView.title"
      focusComponent="form">
    <actions>
        <action id="okAction"
                text="msg:///actions.Ok"
                icon="DETAIL_SAVE_CLOSE_ACTION"
                actionVariant="PRIMARY"
                shortcutCombination="${SAVE_SHORTCUT}"/>
        <action id="closeAction" type="view_close"/>
    </actions>
    <layout padding="false" expand="form" alignItems="STRETCH"
            classNames="holiday-calendar-days-add-view">
        <formLayout id="form" classNames="margin-inline-m">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
            </responsiveSteps>

            <textField id="nameField"
                       label="msg://com.glebfox.timesheets.entity.schedule/HolidayCalendarDay.name"
                       required="true"
                       requiredMessage="msg://nameField.requiredMessage"
                       maxLength="255">
                <prefix>
                    <icon icon="fontawesome-regular:address-card"/>
                </prefix>
            </textField>
            <!-- Two date pickers joined by a dash read as one field, with the range summary as its helper -->
            <vbox id="datesBox" padding="false" spacing="false">
                <hbox id="datesRangeBox" width="100%" alignItems="BASELINE">
                    <datePicker id="fromField"
                                datatype="localDate"
                                label="msg://fromField.label"
                                required="true"
                                requiredMessage="msg://fromField.requiredMessage"
                                width="100%" minWidth="0"/>
                    <span id="datesSeparator" text="msg://datesSeparator.text"/>
                    <datePicker id="toField"
                                datatype="localDate"
                                ariaLabel="msg://toField.ariaLabel"
                                width="100%" minWidth="0"/>
                </hbox>
                <span id="rangeSummary" classNames="range-summary"/>
            </vbox>
            <radioButtonGroup id="typeField"
                              label="msg://com.glebfox.timesheets.entity.schedule/HolidayCalendarDay.type"
                              itemsEnum="com.glebfox.timesheets.entity.schedule.HolidayCalendarDayType"
                              required="true"
                              requiredMessage="msg://typeField.requiredMessage"
                              classNames="segmented-group"/>
        </formLayout>
        <hbox id="detailActions"
              classNames="footer-panel">
            <button id="okBtn" action="okAction"/>
            <button id="cancelBtn" action="closeAction"/>
        </hbox>
    </layout>
</view>
