<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://holidayCalendarListView.title"
      focusComponent="nameFilterField">
    <data readOnly="true">
        <collection id="holidayCalendarsDc"
                    class="com.glebfox.timesheets.entity.schedule.HolidayCalendar">
            <fetchPlan extends="_base"/>
            <loader id="holidayCalendarsDl" readOnly="true">
                <query>
                    <![CDATA[select e from ts_HolidayCalendar e order by e.name]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
            <propertyFilter component="nameFilter"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false" spacing="false" alignItems="STRETCH" expand="contentBox">
        <vbox id="contentBox" classNames="overflow-auto">
            <propertyFilter id="nameFilter"
                            dataLoader="holidayCalendarsDl" property="name"
                            operation="CONTAINS"
                            labelVisible="false"
                            width="100%" maxWidth="30em">
                <textField id="nameFilterField"
                           placeholder="msg://nameFilter.placeholder"
                           clearButtonVisible="true">
                    <prefix>
                        <icon icon="gravity-ui:magnifier"/>
                    </prefix>
                </textField>
            </propertyFilter>

            <hbox id="buttonsPanel" classNames="buttons-panel">
                <button id="createBtn" action="holidayCalendarsDataGrid.create"/>
                <button id="editBtn" action="holidayCalendarsDataGrid.edit"/>
                <button id="removeBtn" action="holidayCalendarsDataGrid.remove"/>
                <simplePagination id="pagination" dataLoader="holidayCalendarsDl"/>
            </hbox>
            <dataGrid id="holidayCalendarsDataGrid"
                      width="100%"
                      minHeight="20em"
                      dataContainer="holidayCalendarsDc">
                <actions>
                    <action id="create" type="list_create"/>
                    <action id="edit" type="list_edit"/>
                    <action id="remove" type="list_remove"/>
                </actions>
                <columns resizable="true">
                    <column property="name" autoWidth="true"/>
                    <column key="filledUntil" header="msg://filledUntilColumn.header" autoWidth="true" flexGrow="0"/>
                    <column property="description" flexGrow="2">
                        <popoverRenderer/>
                    </column>
                </columns>
            </dataGrid>
        </vbox>
        <hbox id="lookupActions" visible="false"
              classNames="footer-panel">
            <button id="selectBtn" action="selectAction"/>
            <button id="discardBtn" action="discardAction"/>
        </hbox>
    </layout>
</view>
