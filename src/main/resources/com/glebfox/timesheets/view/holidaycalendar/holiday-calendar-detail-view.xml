<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://holidayCalendarDetailView.title"
      focusComponent="form">
    <data>
        <instance id="holidayCalendarDc"
                  class="com.glebfox.timesheets.entity.schedule.HolidayCalendar">
            <fetchPlan extends="_base">
                <property name="days" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
            <collection id="daysDc" property="days"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout alignItems="STRETCH"
            padding="false" spacing="false"
            expand="contentBox">
        <vbox id="contentBox" classNames="overflow-auto" expand="daysDataGrid">
            <formLayout id="form" dataContainer="holidayCalendarDc">
                <textField id="nameField" property="name">
                    <prefix>
                        <icon icon="fontawesome-regular:address-card"/>
                    </prefix>
                </textField>
                <textArea id="descriptionField" property="description"
                          minHeight="10rem" colspan="2"/>
            </formLayout>

            <h4 id="daysTitle" text="msg://com.glebfox.timesheets.entity.schedule/HolidayCalendar.days"/>
            <hbox id="daysButtonsPanel" classNames="buttons-panel">
                <button id="dayCreateBtn" action="daysDataGrid.create"/>
                <button id="dayEditBtn" action="daysDataGrid.edit"/>
                <button id="dayRemoveBtn" action="daysDataGrid.remove"/>
            </hbox>
            <dataGrid id="daysDataGrid"
                      dataContainer="daysDc"
                      selectionMode="MULTI"
                      width="100%" minHeight="20em">
                <actions>
                    <action id="create" type="list_holidayCalendarDays_add"/>
                    <action id="edit" type="list_edit">
                        <properties>
                            <property name="openMode" value="DIALOG"/>
                        </properties>
                    </action>
                    <action id="remove" type="list_remove"/>
                </actions>
                <columns resizable="true">
                    <column property="date" autoWidth="true" flexGrow="0"/>
                    <column property="type" autoWidth="true" flexGrow="0"/>
                    <column property="name"/>
                </columns>
            </dataGrid>
        </vbox>
        <hbox id="detailActions"
              classNames="footer-panel">
            <button id="saveAndCloseBtn" action="saveAction"/>
            <button id="closeBtn" action="closeAction"/>
        </hbox>
    </layout>
</view>
