<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://workScheduleDetailView.title"
      focusComponent="form">
    <data>
        <instance id="workScheduleDc"
                  class="com.glebfox.timesheets.entity.schedule.WorkSchedule">
            <fetchPlan extends="_base">
                <property name="holidayCalendar" fetchPlan="_instance_name">
                    <property name="deletedDate"/>
                </property>
            </fetchPlan>
            <loader/>
        </instance>
        <collection id="assignmentsDc"
                    class="com.glebfox.timesheets.entity.schedule.WorkScheduleAssignment">
            <!-- The user cell shows the avatar and the active flag; the assignment editor checks start dates
                 by user; deletedDate marks a deleted schedule there -->
            <fetchPlan extends="_local">
                <property name="user" fetchPlan="_instance_name">
                    <property name="avatar"/>
                    <property name="active"/>
                </property>
                <property name="workSchedule" fetchPlan="_instance_name">
                    <property name="deletedDate"/>
                </property>
            </fetchPlan>
            <!-- Loaded by the controller for a saved schedule. Only explicit assignments are listed:
                 the default schedule's users without assignments are not -->
            <loader id="assignmentsDl">
                <query>
                    <![CDATA[select e from ts_WorkScheduleAssignment e
                                where e.workSchedule = :workSchedule
                                order by e.startDate desc]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout alignItems="STRETCH"
            padding="false" spacing="false"
            expand="contentBox">
        <vbox id="contentBox" classNames="overflow-auto" expand="usersBox">
            <formLayout id="form" dataContainer="workScheduleDc">
                <textField id="nameField" property="name">
                    <prefix>
                        <icon icon="fontawesome-regular:address-card"/>
                    </prefix>
                </textField>
                <textField id="workdayTimeField" property="workdayTime"
                           placeholder="msg://workdayTimeField.placeholder">
                    <prefix>
                        <icon icon="gravity-ui:clock"/>
                    </prefix>
                </textField>
                <checkboxGroup id="workdaysField"
                               label="msg://workdaysField.label"
                               required="true"
                               requiredMessage="msg://workdaysField.requiredMessage"
                               classNames="segmented-group"
                               colspan="2"/>
                <entityComboBox id="holidayCalendarField" property="holidayCalendar">
                    <prefix>
                        <icon icon="gravity-ui:calendar"/>
                    </prefix>
                    <actions>
                        <action id="entityLookup" type="entity_lookup"/>
                        <action id="entityClear" type="entity_clear"/>
                    </actions>
                    <itemsQuery class="com.glebfox.timesheets.entity.schedule.HolidayCalendar"
                                searchStringFormat="(?i)%${inputString}%"
                                escapeValueForLike="true">
                        <fetchPlan extends="_instance_name"/>
                        <query>
                            <![CDATA[select e from ts_HolidayCalendar e
                                        where e.name like :searchString escape '\'
                                        order by e.name]]>
                        </query>
                    </itemsQuery>
                </entityComboBox>
                <switch id="isDefaultField" property="isDefault"/>
                <textArea id="descriptionField" property="description"
                          minHeight="10rem" colspan="2"/>
            </formLayout>
            <vbox id="usersBox" padding="false" expand="assignmentsDataGrid">
                <h4 id="usersTitle" text="msg://usersTitle.text"/>
                <hbox id="assignmentsButtonsPanel" classNames="buttons-panel">
                    <button id="assignmentAddBtn" action="assignmentsDataGrid.add"/>
                    <button id="assignmentEditBtn" action="assignmentsDataGrid.edit"/>
                    <button id="assignmentRemoveBtn" action="assignmentsDataGrid.remove"/>
                </hbox>
                <dataGrid id="assignmentsDataGrid"
                          dataContainer="assignmentsDc"
                          selectionMode="MULTI"
                          width="100%" minHeight="20em">
                    <actions>
                        <action id="add" type="list_workScheduleUsers_add"/>
                        <action id="edit" type="list_workScheduleAssignment_edit"/>
                        <action id="remove" type="list_workScheduleAssignment_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="user"/>
                        <!-- A fixed width, not autoWidth: the Current badge can appear after the table is sized,
                             on an assignment added or edited here. It fits the widest date with the badge
                             in English and Russian -->
                        <column property="startDate" width="11rem" flexGrow="0"/>
                    </columns>
                </dataGrid>
            </vbox>
        </vbox>
        <hbox id="detailActions"
              classNames="footer-panel">
            <button id="saveAndCloseBtn" action="saveAction"/>
            <button id="closeBtn" action="closeAction"/>
        </hbox>
    </layout>
</view>
