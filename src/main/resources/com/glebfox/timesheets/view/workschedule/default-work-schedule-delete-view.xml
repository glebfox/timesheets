<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://defaultWorkScheduleDeleteView.title"
      focusComponent="newDefaultField">
    <data readOnly="true">
        <collection id="otherSchedulesDc"
                    class="com.glebfox.timesheets.entity.schedule.WorkSchedule">
            <fetchPlan extends="_instance_name"/>
            <!-- Loaded by the controller once the schedule to delete is set -->
            <loader id="otherSchedulesDl" readOnly="true">
                <query>
                    <![CDATA[select e from ts_WorkSchedule e
                                where e.id <> :scheduleId
                                order by e.name]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="closeAction" type="view_close" text="msg:///actions.Cancel"/>
    </actions>
    <layout padding="false" spacing="false"
            alignItems="STRETCH"
            expand="contentBox">
        <vbox id="contentBox" alignItems="STRETCH" classNames="overflow-auto">
            <span id="messageText"/>
            <entityComboBox id="newDefaultField"
                            metaClass="ts_WorkSchedule"
                            itemsContainer="otherSchedulesDc"
                            label="msg://newDefaultField.label"
                            helperText="msg://newDefaultField.helperText"
                            required="true">
                <prefix>
                    <icon icon="gravity-ui:star"/>
                </prefix>
            </entityComboBox>
        </vbox>
        <hbox id="detailActions"
              classNames="footer-panel">
            <button id="deleteBtn" text="msg://deleteBtn.text" themeNames="primary error"/>
            <button id="cancelBtn" action="closeAction"/>
        </hbox>
    </layout>
</view>
