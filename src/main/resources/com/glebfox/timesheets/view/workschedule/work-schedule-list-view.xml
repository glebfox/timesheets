<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://workScheduleListView.title"
      focusComponent="workSchedulesDataGrid">
    <data readOnly="true">
        <collection id="workSchedulesDc"
                    class="com.glebfox.timesheets.entity.schedule.WorkSchedule">
            <fetchPlan extends="_base">
                <property name="holidayCalendar" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="workSchedulesDl" readOnly="true">
                <query>
                    <![CDATA[select e from ts_WorkSchedule e order by e.name]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false" spacing="false" alignItems="STRETCH" expand="contentBox"
            classNames="work-schedule-list-view">
        <vbox id="contentBox" classNames="overflow-auto">
            <genericFilter id="genericFilter"
                           dataLoader="workSchedulesDl">
                <properties include=".*"/>
            </genericFilter>
            <hbox id="buttonsPanel" classNames="buttons-panel">
                <button id="createBtn" action="workSchedulesDataGrid.create"/>
                <button id="editBtn" action="workSchedulesDataGrid.edit"/>
                <button id="removeBtn" action="workSchedulesDataGrid.remove"/>
                <button id="makeDefaultBtn" action="workSchedulesDataGrid.makeDefault"/>
                <simplePagination id="pagination" dataLoader="workSchedulesDl"/>
            </hbox>
            <dataGrid id="workSchedulesDataGrid"
                      width="100%"
                      minHeight="20em"
                      dataContainer="workSchedulesDc">
                <actions>
                    <action id="create" type="list_create"/>
                    <action id="edit" type="list_edit"/>
                    <action id="remove" type="list_workSchedule_remove"/>
                    <action id="makeDefault" type="list_workSchedule_makeDefault"/>
                </actions>
                <columns resizable="true">
                    <column property="name" autoWidth="true"/>
                    <column property="workdayTime" autoWidth="true" flexGrow="0"/>
                    <column key="workdays" header="msg://workdaysColumn.header" autoWidth="true" flexGrow="0"/>
                    <column property="holidayCalendar"/>
                    <column property="description" flexGrow="2">
                        <popoverRenderer/>
                    </column>
                </columns>
            </dataGrid>
        </vbox>
        <hbox id="lookupActions" visible="false"
              classNames="footer-panel">
            <button id="selectBtn" action="selectAction"/>
            <button id="discardBtn" action="discardAction"/>
        </hbox>
    </layout>
</view>
