<fragment xmlns="http://jmix.io/schema/flowui/fragment"
          xmlns:app="http://glebfox.com/schema/app-ui-components.xsd"
          xmlns:charts="http://jmix.io/schema/charts/ui">
    <content>
        <!-- The subtitle names the month, so the controller sets it -->
        <card id="root" title="msg://timeByProjectBlock.title">
            <content>
                <div id="body" classNames="dashboard-projects">
                    <div id="projects" classNames="dashboard-projects-content">
                        <div id="donut" classNames="dashboard-donut">
                            <charts:chart id="chart" classNames="dashboard-donut-chart"/>
                            <span id="total" classNames="dashboard-donut-total"/>
                        </div>
                        <div id="projectList" classNames="dashboard-project-list"/>
                    </div>
                    <app:gridEmptyState id="emptyState"
                                        icon="ts:projects"
                                        text="msg://timeByProjectBlock.emptyState"/>
                </div>
            </content>
        </card>
    </content>
</fragment>
