<fragment xmlns="http://jmix.io/schema/flowui/fragment">
    <content>
        <div id="root" classNames="dashboard">
            <div id="header" classNames="dashboard-header">
                <div id="headerText" classNames="dashboard-header-text">
                    <h2 id="greeting" classNames="dashboard-greeting"/>
                    <span id="today" classNames="dashboard-today"/>
                </div>
                <div id="headerActions" classNames="dashboard-header-actions">
                    <button id="logTimeButton"
                            text="msg://logTimeButton.text"
                            icon="CREATE_ACTION"
                            themeNames="primary"/>
                    <button id="refreshButton"
                            icon="REFRESH_ACTION"
                            ariaLabel="msg://refreshButton.tooltip">
                        <tooltip text="msg://refreshButton.tooltip"/>
                    </button>
                </div>
            </div>

            <!-- Each section's blocks are the fragments of DashboardBlock, in the spec's order -->
            <h3 id="myTimeHeading" text="msg://myTimeHeading.text" classNames="dashboard-section-heading"
                visible="false"/>
            <div id="myTimeBlocks" classNames="dashboard-blocks">
                <fragment id="thisWeekBlock" class="com.glebfox.timesheets.view.dashboard.ThisWeekBlock"/>
                <fragment id="needsAttentionBlock" class="com.glebfox.timesheets.view.dashboard.NeedsAttentionBlock"/>
                <fragment id="recentWeeksBlock" class="com.glebfox.timesheets.view.dashboard.RecentWeeksBlock"/>
                <fragment id="timeByProjectBlock" class="com.glebfox.timesheets.view.dashboard.TimeByProjectBlock"/>
                <fragment id="comingUpBlock" class="com.glebfox.timesheets.view.dashboard.ComingUpBlock"/>
                <fragment id="recentEntriesBlock" class="com.glebfox.timesheets.view.dashboard.RecentEntriesBlock"/>
            </div>

            <h3 id="myTeamHeading" text="msg://myTeamHeading.text" classNames="dashboard-section-heading"
                visible="false"/>
            <div id="myTeamBlocks" classNames="dashboard-blocks">
                <fragment id="waitingApprovalBlock" class="com.glebfox.timesheets.view.dashboard.WaitingApprovalBlock"/>
                <fragment id="teamWeekBlock" class="com.glebfox.timesheets.view.dashboard.TeamWeekBlock"/>
                <fragment id="teamAwayBlock" class="com.glebfox.timesheets.view.dashboard.TeamAwayBlock"/>
            </div>
        </div>
    </content>
</fragment>
