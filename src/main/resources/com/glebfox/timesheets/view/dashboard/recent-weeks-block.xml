<fragment xmlns="http://jmix.io/schema/flowui/fragment"
          xmlns:charts="http://jmix.io/schema/charts/ui">
    <content>
        <!-- The title names the number of weeks, so the controller sets it -->
        <card id="root">
            <content>
                <div id="body" classNames="dashboard-chart-block">
                    <div id="chartArea" classNames="dashboard-chart-area">
                        <charts:chart id="chart" classNames="dashboard-chart"/>
                        <div id="legend" classNames="dashboard-chart-legend"/>
                    </div>
                </div>
            </content>
        </card>
    </content>
</fragment>
