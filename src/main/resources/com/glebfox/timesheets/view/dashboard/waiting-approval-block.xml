<fragment xmlns="http://jmix.io/schema/flowui/fragment"
          xmlns:app="http://glebfox.com/schema/app-ui-components.xsd">
    <content>
        <card id="root" title="msg://waitingApprovalBlock.title">
            <content>
                <div id="body" classNames="dashboard-list-block">
                    <div id="figure" classNames="dashboard-figure">
                        <span id="count" classNames="dashboard-figure-value"/>
                        <span id="note" classNames="dashboard-figure-note"/>
                    </div>
                    <div id="rows" classNames="dashboard-list"/>
                    <app:gridEmptyState id="emptyState"
                                        icon="ts:approve-time-entries"
                                        text="msg://waitingApprovalBlock.emptyState"/>
                    <button id="approvalLink"
                            text="msg://waitingApprovalBlock.approvalLink"
                            themeNames="tertiary"
                            classNames="dashboard-list-link"/>
                </div>
            </content>
        </card>
    </content>
</fragment>
