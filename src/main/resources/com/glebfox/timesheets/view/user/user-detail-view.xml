<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:app="http://glebfox.com/schema/app-ui-components.xsd"
      title="msg://UserDetailView.title"
      focusComponent="form">
    <data>
        <instance id="userDc"
                  class="com.glebfox.timesheets.entity.user.User">
            <fetchPlan extends="_base"/>
            <loader/>
        </instance>
    </data>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout alignItems="STRETCH"
            padding="false" spacing="false"
            expand="contentBox">
        <vbox id="contentBox" classNames="overflow-auto">
            <app:imageUpload id="imageUpload"
                             dataContainer="userDc" property="avatar"/>
            <formLayout id="form"
                        dataContainer="userDc">
                <textField id="usernameField" property="username" readOnly="true">
                    <prefix>
                        <icon icon="fontawesome-regular:address-card"/>
                    </prefix>
                </textField>
                <passwordField id="passwordField"
                               label="msg://com.glebfox.timesheets.entity.user/User.password"
                               required="true"
                               visible="false">
                    <prefix>
                        <icon icon="gravity-ui:key"/>
                    </prefix>
                </passwordField>
                <passwordField id="confirmPasswordField"
                               label="msg://confirmPassword"
                               required="true"
                               visible="false">
                    <prefix>
                        <icon icon="gravity-ui:key"/>
                    </prefix>
                </passwordField>
                <textField id="firstNameField" property="firstName">
                    <prefix>
                        <icon icon="fontawesome-regular:address-card"/>
                    </prefix>
                </textField>
                <textField id="lastNameField" property="lastName">
                    <prefix>
                        <icon icon="fontawesome-regular:address-card"/>
                    </prefix>
                </textField>
                <textField id="emailField" property="email">
                    <prefix>
                        <icon icon="gravity-ui:envelope"/>
                    </prefix>
                </textField>
                <comboBox id="timeZoneField" property="timeZoneId">
                    <prefix>
                        <icon icon="gravity-ui:globe"/>
                    </prefix>
                </comboBox>
                <switch id="activeField" property="active"/>
            </formLayout>
        </vbox>
        <hbox id="detailActions"
              classNames="footer-panel">
            <button id="saveAndCloseBtn" action="saveAction"/>
            <button id="closeBtn" action="closeAction"/>
        </hbox>
    </layout>
</view>
