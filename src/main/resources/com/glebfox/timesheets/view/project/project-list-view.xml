<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://projectListView.title"
      focusComponent="projectsDataGrid">
    <data readOnly="true">
        <collection id="projectsDc"
                    class="com.glebfox.timesheets.entity.project.Project">
            <fetchPlan extends="_base">
                <property name="client" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="projectsDl" readOnly="true">
                <query>
                    <![CDATA[select e from ts_Project e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false" spacing="false" alignItems="STRETCH" expand="contentBox">
        <vbox id="contentBox" classNames="overflow-auto">
            <genericFilter id="genericFilter"
                           dataLoader="projectsDl">
                <properties include=".*"/>
            </genericFilter>
            <hbox id="buttonsPanel" classNames="buttons-panel">
                <button id="createBtn" action="projectsDataGrid.create"/>
                <button id="editBtn" action="projectsDataGrid.edit"/>
                <button id="removeBtn" action="projectsDataGrid.remove"/>
                <simplePagination id="pagination" dataLoader="projectsDl"/>
            </hbox>
            <dataGrid id="projectsDataGrid"
                      width="100%"
                      minHeight="20em"
                      dataContainer="projectsDc">
                <actions>
                    <action id="create" type="list_create"/>
                    <action id="edit" type="list_edit"/>
                    <action id="remove" type="list_remove"/>
                </actions>
                <columns resizable="true">
                    <column property="name"/>
                    <column property="client"/>
                    <column property="status" flexGrow="0"/>
                    <column property="description" flexGrow="2">
                        <popoverRenderer markdown="true"/>
                    </column>
                </columns>
            </dataGrid>
        </vbox>
        <hbox id="lookupActions" visible="false"
              classNames="footer-panel">
            <button id="selectBtn" action="selectAction"/>
            <button id="discardBtn" action="discardAction"/>
        </hbox>
    </layout>
</view>
