<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://absenceListView.title"
      focusComponent="userFilterField">
    <data readOnly="true">
        <collection id="absencesDc"
                    class="com.glebfox.timesheets.entity.absence.Absence">
            <!-- The user cell shows the avatar and the active flag. The type is read in a query of its own, which
                 leaves deleted types in, so an absence of a deleted type stays listed (docs/guidelines/database.md);
                 deletedDate marks it -->
            <fetchPlan extends="_local">
                <property name="user" fetchPlan="_instance_name">
                    <property name="avatar"/>
                    <property name="active"/>
                </property>
                <property name="type" fetchPlan="_instance_name" fetch="BATCH">
                    <property name="deletedDate"/>
                </property>
            </fetchPlan>
            <loader id="absencesDl" readOnly="true">
                <query>
                    <![CDATA[select e from ts_Absence e order by e.firstDay desc]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
            <propertyFilter component="userFilter"/>
            <propertyFilter component="typeFilter"/>
            <propertyFilter component="fromFilter"/>
            <propertyFilter component="toFilter"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false" spacing="false" alignItems="STRETCH" expand="contentBox">
        <vbox id="contentBox" classNames="overflow-auto">
            <!-- Not a gridLayout, whose columns are all of one width: the period keeps the width of its two dates,
                 while the user and type filters grow, so the four share one row on a wide screen -->
            <hbox id="filterLayout"
                  width="100%"
                  wrap="true"
                  classNames="absence-list-view-filters">
                <propertyFilter id="userFilter"
                                dataLoader="absencesDl" property="user"
                                operation="EQUAL"
                                labelVisible="false">
                    <entityComboBox id="userFilterField"
                                    metaClass="ts_User"
                                    placeholder="msg://userFilter.placeholder"
                                    width="100%">
                        <itemsQuery class="com.glebfox.timesheets.entity.user.User"
                                    searchStringFormat="(?i)%${inputString}%"
                                    escapeValueForLike="true">
                            <query>
                                <![CDATA[select e from ts_User e
                                            where e.username like :searchString escape '\'
                                                or e.firstName like :searchString escape '\'
                                                or e.lastName like :searchString escape '\'
                                            order by e.username asc]]>
                            </query>
                        </itemsQuery>
                        <actions>
                            <action id="clear" type="entity_clear"/>
                        </actions>
                        <prefix>
                            <icon icon="gravity-ui:magnifier"/>
                        </prefix>
                    </entityComboBox>
                </propertyFilter>
                <propertyFilter id="typeFilter"
                                dataLoader="absencesDl" property="type"
                                operation="EQUAL"
                                labelVisible="false">
                    <entityComboBox id="typeFilterField"
                                    metaClass="ts_AbsenceType"
                                    placeholder="msg://typeFilter.placeholder"
                                    width="100%">
                        <itemsQuery class="com.glebfox.timesheets.entity.absence.AbsenceType"
                                    searchStringFormat="(?i)%${inputString}%"
                                    escapeValueForLike="true">
                            <query>
                                <![CDATA[select e from ts_AbsenceType e
                                            where e.name like :searchString escape '\'
                                            order by e.name]]>
                            </query>
                        </itemsQuery>
                        <actions>
                            <action id="clear" type="entity_clear"/>
                        </actions>
                        <prefix>
                            <icon icon="gravity-ui:magnifier"/>
                        </prefix>
                    </entityComboBox>
                </propertyFilter>
                <!-- From and To together keep the absences that share at least one day with the period. They read
                     as one range, as the editor's dates do: two dates joined by a dash, each picker at its default
                     width, which holds a date and its buttons, and narrower only on a screen narrower than both -->
                <hbox id="periodFilterBox"
                      alignItems="BASELINE"
                      minWidth="0"
                      classNames="absence-list-view-period-filter">
                    <propertyFilter id="fromFilter"
                                    dataLoader="absencesDl" property="lastDay"
                                    operation="GREATER_OR_EQUAL"
                                    labelVisible="false"
                                    minWidth="0">
                        <datePicker id="fromFilterField"
                                    datatype="localDate"
                                    placeholder="msg://fromFilter.placeholder"
                                    ariaLabel="msg://fromFilterField.ariaLabel"
                                    clearButtonVisible="true"/>
                    </propertyFilter>
                    <span id="periodFilterSeparator" text="msg://datesSeparator.text"/>
                    <propertyFilter id="toFilter"
                                    dataLoader="absencesDl" property="firstDay"
                                    operation="LESS_OR_EQUAL"
                                    labelVisible="false"
                                    minWidth="0">
                        <datePicker id="toFilterField"
                                    datatype="localDate"
                                    placeholder="msg://toFilter.placeholder"
                                    ariaLabel="msg://toFilterField.ariaLabel"
                                    clearButtonVisible="true"/>
                    </propertyFilter>
                </hbox>
            </hbox>

            <hbox id="buttonsPanel" classNames="buttons-panel">
                <button id="createBtn" action="absencesDataGrid.create"/>
                <button id="editBtn" action="absencesDataGrid.edit"/>
                <button id="removeBtn" action="absencesDataGrid.remove"/>
                <simplePagination id="pagination" dataLoader="absencesDl"/>
            </hbox>
            <dataGrid id="absencesDataGrid"
                      width="100%"
                      minHeight="20em"
                      dataContainer="absencesDc"
                      selectionMode="MULTI">
                <!-- The editor opens as a 480px dialog over the list, as the user chose for absences, unlike
                     the other lists, whose editors open by navigation -->
                <actions>
                    <action id="create" type="list_create">
                        <properties>
                            <property name="openMode" value="DIALOG"/>
                        </properties>
                    </action>
                    <action id="edit" type="list_edit">
                        <properties>
                            <property name="openMode" value="DIALOG"/>
                        </properties>
                    </action>
                    <action id="remove" type="list_remove"/>
                </actions>
                <columns resizable="true">
                    <column property="user" autoWidth="true"/>
                    <column property="type" autoWidth="true"/>
                    <column key="dates" header="msg://datesColumn.header" autoWidth="true" flexGrow="0"/>
                    <column key="days" header="msg://daysColumn.header" autoWidth="true" flexGrow="0"/>
                    <column property="comment" flexGrow="2">
                        <popoverRenderer/>
                    </column>
                </columns>
            </dataGrid>
        </vbox>
        <hbox id="lookupActions" visible="false"
              classNames="footer-panel">
            <button id="selectBtn" action="selectAction"/>
            <button id="discardBtn" action="discardAction"/>
        </hbox>
    </layout>
</view>
